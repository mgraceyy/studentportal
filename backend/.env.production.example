# PRODUCTION ENVIRONMENT TEMPLATE
# Use these as reference when setting environment variables on Render
# Replace the placeholder values with your actual production values

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (CORS) - Your Vercel admin panel URL
FRONTEND_URL=https://your-project-name.vercel.app

# Database - Get these from Render PostgreSQL service
DB_HOST=your-database-host.render.com
DB_PORT=5432
DB_NAME=student_portal
DB_USER=your_db_user
DB_PASSWORD=your_postgres_connection_password

# Authentication - Generate a secure random string for production
JWT_SECRET=generate-a-long-random-secret-string-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10
